    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

@model List<project_cuoiky.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";

    decimal total = 0;
}


<div class="content_section cart_page">

    <h2>Shopping Cart</h2>


    @if (TempData["CartMessage"] != null)
    {
        <div class="cart_message cart_success">
            @TempData["CartMessage"]
        </div>
    }


    @if (TempData["CartError"] != null)
    {
        <div class="cart_message cart_error">
            @TempData["CartError"]
        </div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="cart_empty">

            <p>
                Your shopping cart is empty.
            </p>

            <div class="button_01">

                <a asp-controller="Home"
                   asp-action="Index">

                    Continue Shopping

                </a>

            </div>

        </div>
    }


    else
    {
        <table class="cart_table">

            <thead>

                <tr>

                    <th>Product</th>

                    <th>Price</th>

                    <th>Quantity</th>

                    <th>Total</th>

                    <th></th>

                </tr>

            </thead>


            <tbody>

                @foreach (var item in Model)
                {
                    decimal itemTotal =
                    item.Price * item.Quantity;

                    total += itemTotal;


                    <tr>

                        <td>

                            <div class="cart_product">

                                <a asp-controller="Product"
                                   asp-action="Detail"
                                   asp-route-id="@item.ProductId">

                                    <img src="~/assets/images02/@item.Image"
                                         alt="@item.Name" />

                                </a>


                                <div class="cart_product_info">

                                    <a asp-controller="Product"
                                       asp-action="Detail"
                                       asp-route-id="@item.ProductId">

                                        @item.Name

                                    </a>


                                    <small>
                                        Stock: @item.Stock
                                    </small>

                                </div>

                            </div>

                        </td>


                        <td class="cart_price">

                            @item.Price.ToString("N0") đ

                        </td>

                        <td>

                            <form asp-controller="Cart"
                                  asp-action="Update"
                                  method="post"
                                  class="cart_update_form">

                                <input type="hidden"
                                       name="productId"
                                       value="@item.ProductId" />


                                <input type="number"
                                       name="quantity"
                                       value="@item.Quantity"
                                       min="1"
                                       max="@item.Stock"
                                       class="cart_quantity" />


                                <button type="submit"
                                        class="cart_update_button">

                                    Update

                                </button>

                            </form>

                        </td>

                        <td class="cart_subtotal">

                            @itemTotal.ToString("N0") đ

                        </td>

                        <td>

                            <form asp-controller="Cart"
                                  asp-action="Remove"
                                  method="post">

                                <input type="hidden"
                                       name="productId"
                                       value="@item.ProductId" />


                                <button type="submit"
                                        class="cart_remove_button">

                                    Remove

                                </button>

                            </form>

                        </td>

                    </tr>
                }


                <tr class="cart_total_row">

                    <td colspan="3">

                        Total:

                    </td>


                    <td colspan="2"
                        class="cart_grand_total">

                        @total.ToString("N0") đ

                    </td>

                </tr>

            </tbody>

        </table>


        <div class="cart_bottom_actions">


            <a asp-controller="Home"
               asp-action="Index"
               class="cart_continue_button">

                Continue Shopping

            </a>


            <form asp-controller="Cart"
                  asp-action="Clear"
                  method="post">

                <button type="submit"
                        class="cart_clear_button"
                        onclick="return confirm('Clear all products from cart?')">

                    Clear Cart

                </button>

            </form>


        </div>
    }


    <div class="cleaner"></div>

</div>