@{
}
@model List<project_cuoiky.Models.Category>

    <h2>Categories</h2>

    <ul class="categories_list">
        @foreach (var category in Model)
        {
            <li>
                <a asp-controller="Product"
                   asp-action="Index"
                   asp-route-categoryId="@category.Id">
                    @category.Name
                </a>
            </li>
        }
    </ul>
</div>