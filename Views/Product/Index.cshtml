    For more information on enabling MVC for empty projects,
    visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

@model List<project_cuoiky.Models.Product>

@{
    ViewData["Title"] = ViewBag.PageTitle ?? "Products";
}


@if (Model == null || Model.Count == 0)
{
    <h2>
        @ViewBag.PageTitle
    </h2>

    <p>
        No products found.
    </p>
}
else
{


    <h2>
        @ViewBag.PageTitle
    </h2>


    @for (int i = 0; i < Model.Count; i++)
    {
        var product = Model[i];


        <div class="product_box @(i % 3 == 2 ? "" : "margin_r35")"
             style="float: left;
                    width: 200px;
                    @(i % 3 == 2 ? "" : "margin-right: 35px;")">



            <h3>
                @product.Category?.Name
            </h3>



            <div class="image_wrapper">


                <a asp-controller="Product"
                   asp-action="Detail"
                   asp-route-id="@product.Id">


                    <img src="~/assets/images02/@product.Image"
                         alt="@product.Name"
                         style="max-width: 100%;
                                height: 120px;
                                object-fit: contain;" />


                </a>


            </div>


            <p style="width: 200px;
                      white-space: nowrap;
                      overflow: hidden;
                      text-overflow: ellipsis;"
               title="@product.Name">


                @product.Name


            </p>


            <p class="price">

                Price:
                @product.Price.ToString("N0") đ

            </p>



            <a asp-controller="Product"
               asp-action="Detail"
               asp-route-id="@product.Id">

                Detail

            </a>


            |


            @if (product.Quantity > 0)
            {
                <form asp-controller="Cart"
                      asp-action="Add"
                      method="post"
                      style="display: inline;">


                    <input type="hidden"
                           name="productId"
                           value="@product.Id" />


                    <input type="hidden"
                           name="quantity"
                           value="1" />


                    <button type="submit"
                            class="cart_link_button">

                        Buy Now

                    </button>


                </form>
            }
            else
            {
                <span style="color: red;">

                    Out of Stock

                </span>
            }


        </div>



        @if ((i + 1) % 3 == 0)
        {
            <div class="cleaner"></div>
        }
    }


    <div class="cleaner"></div>
}