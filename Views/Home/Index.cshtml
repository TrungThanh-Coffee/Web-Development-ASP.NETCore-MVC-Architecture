@model IEnumerable<project_cuoiky.Models.Product>

@{
    ViewData["Title"] = "Home Page";
}

@* <div id="templatmeo_content"> *@


@* =========================================================
   FEATURED PRODUCTS
   ========================================================= *@
<div id="latest_product_gallery">

    <h2>Featured Products</h2>

    <div id="SlideItMoo_outer">

        <div id="SlideItMoo_inner">

            <div id="SlideItMoo_items">

                @foreach (var product in Model.Take(8))
                {
                    <div class="SlideItMoo_element">

                        @* Khi bấm vào ảnh Featured Product sẽ chuyển sang trang Detail *@
                        <a asp-controller="Product"
                           asp-action="Detail"
                           asp-route-id="@product.Id">

                            <img src="~/assets/images02/@product.Image"
                                 alt="@product.Name"
                                 style="max-width: 100%;
                                        height: 100px;
                                        object-fit: contain;" />

                        </a>

                    </div>
                }

            </div>

        </div>

    </div>

</div>
<!-- end of latest_content_gallery -->
@* =========================================================
   WELCOME
   ========================================================= *@
<div class="content_section">

    <h2>Welcome to Pink Shop</h2>

    <p>
        Welcome to Pink Shop, where you can discover a wide range
        of perfumes for men, women and unisex.
    </p>

</div>



@* =========================================================
   OUR PRODUCTS
   ========================================================= *@
<div class="content_section">

    <h2>Our Products</h2>

    @{
        int index = 0;
    }


    @foreach (var product in Model.Take(6))
    {
        @* =====================================================
    SẢN PHẨM THỨ 3, 6
    Không cần margin bên phải
    ===================================================== *@
        if (index % 3 == 2)
        {
            <div class="product_box"
                 style="float: left;
                        width: 200px;">

                <h3>
                    @product.Category?.Name
                </h3>


                <div class="image_wrapper">

                    @* Khi bấm vào ảnh sẽ chuyển sang Product Detail *@
                    <a asp-controller="Product"
                       asp-action="Detail"
                       asp-route-id="@product.Id">

                        <img src="~/assets/images02/@product.Image"
                             alt="@product.Name"
                             style="max-width: 100%;
                                    height: 120px;
                                    object-fit: contain;" />

                    </a>

                </div>


                @* Tên sản phẩm *@
                <p style="width: 200px;
                          white-space: nowrap;
                          overflow: hidden;
                          text-overflow: ellipsis;"
                   title="@product.Name">

                    @product.Name

                </p>


                @* Giá sản phẩm *@
                <p class="price">

                    Price: @product.Price.ToString("N0") đ

                </p>


                @* Link sang trang chi tiết sản phẩm *@
                <a asp-controller="Product"
                   asp-action="Detail"
                   asp-route-id="@product.Id">

                    Detail

                </a>

                |

                @* =================================================
        THÊM SẢN PHẨM VÀO GIỎ HÀNG
        ================================================= *@
                @if (product.Quantity > 0)
                {
                    <form asp-controller="Cart"
                          asp-action="Add"
                          method="post"
                          style="display: inline;">

                        <input type="hidden"
                               name="productId"
                               value="@product.Id" />

                        <input type="hidden"
                               name="quantity"
                               value="1" />

                        <button type="submit"
                                class="cart_link_button">

                            Buy Now

                        </button>

                    </form>
                }
                else
                {
                    <span style="color: red;">
                        Out of Stock
                    </span>
                }

            </div>
        }


        @* =====================================================
    SẢN PHẨM THỨ 1, 2, 4, 5
    Có margin bên phải
    ===================================================== *@
        else
        {
            <div class="product_box margin_r35"
                 style="float: left;
                        width: 200px;
                        margin-right: 35px;">

                <h3>
                    @product.Category?.Name
                </h3>


                <div class="image_wrapper">

                    @* Khi bấm vào ảnh sẽ chuyển sang Product Detail *@
                    <a asp-controller="Product"
                       asp-action="Detail"
                       asp-route-id="@product.Id">

                        <img src="~/assets/images02/@product.Image"
                             alt="@product.Name"
                             style="max-width: 100%;
                                    height: 120px;
                                    object-fit: contain;" />

                    </a>

                </div>


                @* Tên sản phẩm *@
                <p style="width: 200px;
                          white-space: nowrap;
                          overflow: hidden;
                          text-overflow: ellipsis;"
                   title="@product.Name">

                    @product.Name

                </p>


                @* Giá sản phẩm *@
                <p class="price">

                    Price: @product.Price.ToString("N0") đ

                </p>


                @* Link sang trang chi tiết sản phẩm *@
                <a asp-controller="Product"
                   asp-action="Detail"
                   asp-route-id="@product.Id">

                    Detail

                </a>

                |

                @* =================================================
        THÊM SẢN PHẨM VÀO GIỎ HÀNG
        ================================================= *@
                @if (product.Quantity > 0)
                {
                    <form asp-controller="Cart"
                          asp-action="Add"
                          method="post"
                          style="display: inline;">

                        <input type="hidden"
                               name="productId"
                               value="@product.Id" />

                        <input type="hidden"
                               name="quantity"
                               value="1" />

                        <button type="submit"
                                class="cart_link_button">

                            Buy Now

                        </button>

                    </form>
                }
                else
                {
                    <span style="color: red;">
                        Out of Stock
                    </span>
                }

            </div>
        }


        index++;


        @* Sau mỗi 3 sản phẩm thì clear float để xuống hàng *@
        if (index % 3 == 0)
        {
            <div class="cleaner"></div>
        }
    }


    <div class="cleaner"></div>


    <div class="button_01">

        <a asp-controller="Product"
           asp-action="Index">

            View All

        </a>

    </div>

</div>


@* </div> <!-- end of templatmeo_content --> *@